<Window x:Class="MemoryBloom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:MemoryBloom"
        Title="Memory Bloom" Icon="Assets/MemoryBloom.ico"
        WindowStyle="None" AllowsTransparency="False" Background="#FF1A2225"
        ShowInTaskbar="True" ResizeMode="CanResize" Topmost="True"
        Width="292" Height="116" MinWidth="250" MinHeight="96">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ContextMenu x:Key="SurfaceContextMenu" x:Shared="False">
            <MenuItem Header="Exit Memory Bloom" Click="Exit_Click"/>
        </ContextMenu>
    </Window.Resources>
    <Border x:Name="Shell" Background="{StaticResource Panel}" CornerRadius="22" BorderThickness="1"
            BorderBrush="#55697B7D" Padding="12"
            PreviewMouseLeftButtonDown="Shell_PreviewMouseLeftButtonDown"
            PreviewMouseMove="Shell_PreviewMouseMove"
            PreviewMouseLeftButtonUp="Shell_PreviewMouseLeftButtonUp">
        <Grid>
            <Grid x:Name="MinimalView" ContextMenu="{StaticResource SurfaceContextMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CompactLeftColumn" Width="76"/>
                    <ColumnDefinition x:Name="CompactCenterColumn" Width="*"/>
                    <ColumnDefinition x:Name="CompactRightColumn" Width="28"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="MinimalGauge" Width="68" Height="68">
                    <Ellipse Stroke="#31505B60" StrokeThickness="7"/>
                    <Path x:Name="PressureArc" Stroke="#FF75D6B2" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Ellipse x:Name="Pulse" Width="34" Height="34" Fill="#4475D6B2"/>
                    <TextBlock x:Name="PercentText" Text="--" Foreground="{StaticResource TextPrimary}" FontSize="17"
                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel x:Name="MinimalTextPanel" Grid.Column="1" VerticalAlignment="Center" Margin="7,0,4,0">
                    <TextBlock x:Name="PressureTagline" Text="Memory is getting busy" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryText" Text="Checking pressure…" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
                    <TextBlock x:Name="CompactHintText" Text="Click for details · Ctrl+Alt+B" Foreground="#FF75D6B2" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel x:Name="MinimalZoomPanel" Grid.Column="2" VerticalAlignment="Center">
                    <Button Click="ZoomIn_Click" ToolTip="Make larger" Padding="3,0" FontSize="14">+</Button>
                    <Button Click="ZoomOut_Click" ToolTip="Make smaller" Padding="3,0" FontSize="14">−</Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="DetailedView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="92"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="TitleBar" Background="Transparent" ToolTip="Click to switch modes · drag to move"
                      ContextMenu="{StaticResource SurfaceContextMenu}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="HeaderDot" Width="11" Height="11" Fill="#FF75D6B2" Margin="2,0,9,0"/>
                        <TextBlock Text="MEMORY BLOOM" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VisibilityModeText" Text="THRESHOLD" Foreground="#FF75D6B2" FontSize="10"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="LoadingText" Text="Refreshing…" Foreground="{StaticResource TextMuted}" FontSize="10"
                               Margin="280,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PageSwitchButton" Click="PageSwitch_Click" ToolTip="Switch between process and memory history">History</Button>
                        <Button x:Name="FirefoxProcessesButton" Click="OpenFirefoxProcesses_Click" ToolTip="Open Firefox's exact tab/process view">Firefox tabs ↗</Button>
                        <Button Click="ShowMinimal_Click" ToolTip="Return to the compact view">Compact</Button>
                        <Button Click="Hide_Click" ToolTip="Hide until pressure rises">×</Button>
                    </StackPanel>
                </Grid>
                <Grid x:Name="ProcessSummary" Grid.Row="1" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DetailPercent" Text="--%" Foreground="{StaticResource TextPrimary}" FontSize="34" FontWeight="SemiBold"/>
                        <TextBlock Text="overall pressure" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="12,4,0,0">
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock x:Name="PhysicalText" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                        <TextBlock x:Name="CommitText" Grid.Row="1" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                    </Grid>
                </Grid>
                <Border x:Name="ProcessTreeContainer" Grid.Row="2" Background="#66253034" CornerRadius="14" Padding="8">
                    <TreeView x:Name="ProcessTree" Background="Transparent" BorderThickness="0"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItemChanged="ProcessTree_SelectedItemChanged"
                              PreviewMouseRightButtonDown="ProcessTree_PreviewMouseRightButtonDown"
                              MouseDoubleClick="ProcessTree_MouseDoubleClick"/>
                </Border>
                <Grid x:Name="ProcessFooter" Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FocusButton" Click="Focus_Click" IsEnabled="False">Bring to front</Button>
                        <Button x:Name="EndButton" Click="End_Click" IsEnabled="False" Background="#553F2225" BorderBrush="#885E3439">End process…</Button>
                    </StackPanel>
                    <TextBlock x:Name="SelectionText" Grid.Column="1" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                               Margin="8,0" TextTrimming="CharacterEllipsis"/>
                    <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="454">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="218"/>
                            <ColumnDefinition Width="236"/>
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Text size" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <Slider x:Name="ProcessFontSizeSlider" Grid.Column="1" Minimum="10" Maximum="18" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Margin="7,0" ValueChanged="ProcessFontSizeSlider_ValueChanged"
                                    ToolTip="Adjust process and Firefox tab text"/>
                            <TextBlock x:Name="ProcessFontSizeText" Grid.Column="2" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Grid.Column="1" Margin="8,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Alert at" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <Slider x:Name="ThresholdSlider" Grid.Column="1" Minimum="65" Maximum="95" Margin="7,0" ValueChanged="ThresholdSlider_ValueChanged"/>
                            <TextBlock x:Name="ThresholdText" Grid.Column="2" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,2,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="156"/>
                                <ColumnDefinition Width="8"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Compact" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <Button x:Name="CompactStyleButton" Grid.Column="1" Click="CompactStyle_Click" Margin="7,1,0,1" Padding="7,1" Height="24"
                                    ToolTip="Choose a circle that reveals text on hover or the original full card">Circle · text on hover</Button>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="8,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="148"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Visible for" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="VisibilityTimeoutComboBox" Grid.Column="1" Margin="7,1,0,1" Padding="5,1" Height="24"
                                      SelectionChanged="VisibilityTimeoutComboBox_SelectionChanged"
                                      ToolTip="How long Ctrl+Alt+B keeps Bloom visible before returning to threshold control">
                                <ComboBoxItem Content="5 minutes" Tag="5"/>
                                <ComboBoxItem Content="15 minutes" Tag="15"/>
                                <ComboBoxItem Content="30 minutes" Tag="30"/>
                                <ComboBoxItem Content="1 hour" Tag="60"/>
                                <ComboBoxItem Content="Until toggled" Tag="0"/>
                            </ComboBox>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="HistoryPage" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.35*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="HistoryCurrentText" Text="--%" Foreground="{StaticResource TextPrimary}" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock Text="pressure now" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="HistoryPeakText" Text="--%" Foreground="#FFF4BE52" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="peak in view" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="HistorySpikeText" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="flagged events" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock x:Name="HistorySinceText" Text="Starting now" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="continuous history retained 30 days" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#66253034" CornerRadius="14" Padding="6">
                        <local:MemoryHistoryChart x:Name="HistoryChart" MinHeight="250"
                                                  ToolTip="Hover for exact values and top processes · wheel to zoom · drag to pan · double-click for live"/>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Range" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="3,0,5,0"/>
                            <Button Click="History1Hour_Click">1h</Button>
                            <Button Click="History6Hours_Click">6h</Button>
                            <Button Click="History24Hours_Click">24h</Button>
                            <Button Click="History7Days_Click">7d</Button>
                            <Button Click="HistoryAll_Click">All</Button>
                            <Button Click="HistoryLive_Click" Background="#335FD0AA" BorderBrush="#6675D6B2">Live</Button>
                        </StackPanel>
                        <TextBlock x:Name="HistoryRangeText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimary}" Margin="8,0,3,0"/>
                        <TextBlock x:Name="HistoryStatusText" Grid.Row="1" Grid.ColumnSpan="2"
                                   Foreground="{StaticResource TextMuted}" Margin="3,4,3,0" TextWrapping="Wrap"
                                   Text="Memory every 2 s · saved every 10 s · top processes every 30 s · Windows incidents backfilled separately"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
