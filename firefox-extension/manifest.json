{
  "manifest_version": 2,
  "name": "Memory Bloom Companion",
  "version": "0.11.0",
  "description": "Sends Firefox's tab catalog and tab lifecycle events to the local Memory Bloom app.",
  "browser_specific_settings": {
    "gecko": {
      "id": "memory-bloom@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent",
          "websiteActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
